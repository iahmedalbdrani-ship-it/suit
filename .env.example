# ───────── Suitly environment ─────────
# Public site URL (used for SEO, canonical links and payment callbacks)
SITE_URL=https://suitly.online

# Demo mode: shows the demo banner + demo accounts on the login page.
# Set to false before the real launch.
DEMO_MODE=true
# Seed demo apartments/users when the database is empty
SEED_DEMO_DATA=true

# SQLite database file (needs a persistent disk in production)
DATABASE_PATH=./data/suitly.db
# Where host-uploaded photos are stored
UPLOADS_DIR=./data/uploads

# First admin account (created on first start if no admin exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Pricing (rates are decimals). Confirm with your accountant before launch.
# Fees are settings, not assumptions: 0 until the business confirms them (fractions, e.g. 0.05 = 5%).
SERVICE_FEE_RATE=0
VAT_RATE=0
# Minutes a booking holds the dates while waiting for payment
BOOKING_HOLD_MINUTES=15

# Payments: "demo" (no real charge) or "moyasar"
PAYMENT_PROVIDER=demo
# Moyasar secret key — server only, never exposed to the browser
MOYASAR_SECRET_KEY=

# Contact details shown on the site (leave empty to hide)
CONTACT_EMAIL=support@suitly.online
CONTACT_WHATSAPP=
