{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suit",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },

  "d1_databases": [
    // After `wrangler d1 create suitly`, paste the returned database_id here.
    { "binding": "DB", "database_name": "suitly", "database_id": "3418cfdc-af1b-43f2-86ef-bb2116acefd6", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "suitly-uploads" }
  ],

  // Non-secret settings. Secrets (MOYASAR_SECRET_KEY, ADMIN_PASSWORD) go in with `wrangler secret put`.
  "vars": {
    "SITE_URL": "https://suitly.online",
    "DEMO_MODE": "true",
    "NEXT_PUBLIC_DEMO_MODE": "true",
    "PAYMENT_PROVIDER": "demo",
    "SERVICE_FEE_RATE": "0",
    "VAT_RATE": "0",
    "BOOKING_HOLD_MINUTES": "15",
    "CONTACT_EMAIL": "support@suitly.online",
    "CONTACT_WHATSAPP": ""
  }
}
