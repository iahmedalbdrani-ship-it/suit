{
  "name": "suitly",
  "version": "0.1.0",
  "private": true,
  "description": "Suitly — منصة حجز الشقق المفروشة (suitly.online)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "load-test": "node scripts/load-test.mjs",
    "d1:export": "node --conditions=react-server --import tsx scripts/export-d1.ts",
    "cf:build": "CF_BUILD=1 opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/readex-pro": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "@phosphor-icons/react": "^2.1.10",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.0"
  }
}